# Public site origin, without a trailing slash.
APP_URL=http://localhost:3001

# Discord Developer Portal application credentials.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USER_IDS=
# Optional comma-separated role IDs. Leave empty to allow every server member.
DISCORD_ALLOWED_ROLE_IDS=

# Generate a long random value; never commit the real value.
AUTH_SECRET=

# Optional: enables battle-report analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
